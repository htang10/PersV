{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persv-frontend",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "build/client",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
