# ============================================
# CORE
# ============================================

DEBUG
RATE_LIMIT_ENABLED # Global toggle — disables all rate limiting below when false

# ============================================
# DATABASES
# ============================================

# PostgreSQL
# DEMO refers to the dataset used for demo purpose
PG_DEMO_SCHEMA

PG_HOST
PG_PORT
PG_DATABASE

PG_DEMO_USER
PG_DEMO_PASSWORD
PG_AUTH_USER
PG_AUTH_PASSWORD
PG_MIGRATION_USER
PG_MIGRATION_PASSWORD

# Redis
REDIS_HOST
REDIS_PORT
REDIS_USERNAME
REDIS_PASSWORD
REDIS_MAX_CONN
REDIS_CONN_TIMEOUT

# ============================================
# JOB QUEUE
# ============================================

BROKER_URL

# ============================================
# AGENT
# ============================================

OPENAI_MODEL
OPENAI_API_KEY

# ============================================
# AUTHENTICATION
# ============================================

# Credential hashing with a server-side secret key
CREDENTIAL_HMAC_SECRET_KEY

# One-time passcode (OTP)
OTP_EXP
OTP_GENERATION_THROTTLE

# Email sending
SMTP_HOST
SMTP_PORT
SMTP_USERNAME
SMTP_PASSWORD
FROM_EMAIL

# Token-based authentication
# JWT access tokens (stateless) + opaque refresh token (stateful)
JWT_SECRET_KEY
JWT_ISSUER
JWT_AUDIENCE
JWT_ALGORITHM
# Short-lived access token + long-lived refresh token
ACCESS_TOKEN_EXP
REFRESH_TOKEN_EXP

# Access control
MAX_USER_SESSIONS # Concurrent sessions per user, applied across multiple devices
ANON_ID_EXP # How long an anonymous session ID stays valid
ANON_ID_THROTTLE
LOGIN_THROTTLE

# ============================================
# CONNECTION MANAGEMENT
# ============================================

ENCRYPTION_KEY # Encrypts stored connection strings (AES-256-GCM)
CACHE_CAPACITY # Maximum number of connections to be cached for quick retrieval
# When to clean up cache and how much to clean up
CLEANUP_PERIOD
CLEANUP_THRESHOLD
# Idle connections will expire after a specific time period
ANON_CONN_EXP
AUTH_CONN_EXP
