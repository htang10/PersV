# See the corresponding section in `config.py` for default values and accepted types.
# The default settings assume production environment. Other environments may need additional overrides beyond the required variables.

# ============================================
# CORE (src/core/)
# ============================================

DEBUG # Optional
SERVER_HOST
SERVER_PORT

# =========== DATABASES ===========

# PostgreSQL
PG_HOST
PG_PORT
PG_DATABASE
PG_SSL_MODE # Optional
PG_CHANNEL_BINDING # Optional

PG_DEMO_USER
PG_DEMO_PASSWORD
PG_AUTH_USER
PG_AUTH_PASSWORD
PG_MIGRATION_USER
PG_MIGRATION_PASSWORD

# Redis
REDIS_HOST
REDIS_PORT
REDIS_USERNAME
REDIS_PASSWORD
REDIS_MAX_CONN
REDIS_CONN_TIMEOUT

# ============================================
# AGENT (src/agent/)
# ============================================

OPENAI_API_KEY

# ============================================
# AUTHENTICATION & AUTHORIZATION (src/auth/)
# ============================================

# =========== HASHING ===========

# Credential hashing with a server-side secret key
CREDENTIAL_HMAC_SECRET_KEY

# =========== AUTHENTICATION ===========

# OTP
OTP_EXP # Optional

# =========== EMAIL SENDING ===========

SMTP_HOST
SMTP_PORT
SMTP_USERNAME
SMTP_PASSWORD
FROM_EMAIL

# =========== SESSION MANAGEMENT ===========

# Long-lived, opaque refresh token (stateful)
REFRESH_TOKEN_EXP # Optional
# Concurrent sessions per user, applied across multiple devices
MAX_USER_SESSIONS # Optional
# How long an anonymous session ID stays valid
ANON_ID_EXP # Optional

# =========== AUTHORIZATION ===========

# Short-lived, JWT access tokens (stateless)
ACCESS_TOKEN_EXP # Optional

JWT_SECRET_KEY
JWT_ISSUER # Optional
JWT_AUDIENCE # Optional

# =========== RATE LIMIT ===========

RATE_LIMIT_ENABLED # Optional
OTP_GENERATION_LIMIT # Optional
LOGIN_LIMIT # Optional
ANON_ID_LIMIT # Optional

# ============================================
# CONNECTION MANAGEMENT (src/connection/)
# ============================================

ENCRYPTION_KEY # Encrypts stored connection strings (AES-256-GCM)
# Maximum number of connections to be cached for quick retrieval
CACHE_CAPACITY # Optional
# Interval between cache cleanup runs
CLEANUP_PERIOD # Optional
# Fraction of cached entries to remove per cleanup run (e.g. 0.2 = 20%)
CLEANUP_THRESHOLD # Optional
# Idle connections will expire after a specific time period
ANON_CONN_EXP # Optional
AUTH_CONN_EXP # Optional
